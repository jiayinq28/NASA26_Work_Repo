## Servo PWM on Pmod JA1
set_property PACKAGE_PIN Y11      [get_ports servo_pwm]
set_property IOSTANDARD  LVCMOS33 [get_ports servo_pwm]
set_property DRIVE       8        [get_ports servo_pwm]
set_property SLEW        SLOW     [get_ports servo_pwm]

set_property PACKAGE_PIN F22      [get_ports rst]
set_property IOSTANDARD  LVCMOS33 [get_ports rst]

## Clock - 100 MHz onboard oscillator (GCLK), if you're not using the PS FCLK
set_property PACKAGE_PIN Y9       [get_ports clk]
set_property IOSTANDARD  LVCMOS33 [get_ports clk]
create_clock -period 10.000 -name sys_clk [get_ports clk]